# Скопируй этот файл в .env и вставь свой ключ авторизации GigaChat
# (developers.sber.ru → твой проект GigaChat API → «Ключ авторизации»)
GIGACHAT_AUTH_KEY=вставь_сюда_ключ_авторизации

# Модель: GigaChat-2 (Lite), GigaChat-2-Pro или GigaChat-2-Max
GIGACHAT_MODEL=GigaChat-2-Max

# Порт сайта
PORT=3000
